{
  "projectName": "lz4-to-rust-kb",
  "source": {
    "path": "./lz4-src/lz4-1.10.0/lib",
    "language": "c",
    "entryPoints": ["lz4.c"],
    "excludePatterns": [
      ".git",
      "*.o",
      "*.lo",
      "*.la",
      "*.pc",
      "Makefile*",
      "*.md"
    ]
  },
  "target": {
    "language": "rust",
    "framework": "stable",
    "outputPath": "./tmp/lz4-rust-kb-output",
    "buildCommand": "cargo build",
    "testCommand": "cargo test"
  },
  "options": {
    "qualityPolicy": "strict",
    "maxParallelAgents": 3,
    "maxRetriesPerTask": 2,
    "maxLinesPerTask": 500,
    "tokenBudget": 500000,
    "dryRun": false,
    "resume": false,
    "kbIndex": {
      "enabled": true,
      "embeddings": {
        "enabled": true
      }
    }
  },
  "models": {
    "default": "claude-sonnet-4.6"
  },
  "agentBackend": {
    "runtime": "copilot",
    "cliCommand": "copilot",
    "agentDir": "../../../../.github/agents",
    "timeout": 300000
  }
}