{
  "projectName": "tiny-calc-migration",
  "source": {
    "path": ".",
    "language": "python",
    "entryPoints": ["main.py"],
    "excludePatterns": ["__pycache__"]
  },
  "target": {
    "language": "typescript",
    "framework": "none",
    "outputPath": "./tmp/e2e-output"
  },
  "options": {
    "qualityPolicy": "strict",
    "maxParallelAgents": 1,
    "maxRetriesPerTask": 1,
    "maxLinesPerTask": 500,
    "tokenBudget": 100000,
    "dryRun": false,
    "resume": false,
    "kbIndex": {
      "enabled": true,
      "embeddings": {
        "enabled": true
      }
    }
  },
  "models": {
    "default": "claude-sonnet-4.6"
  },
  "agentBackend": {
    "runtime": "copilot",
    "cliCommand": "copilot",
    "agentDir": "../../../../.github/agents",
    "timeout": 300000
  }
}
