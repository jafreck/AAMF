{
  "name": "aamf",
  "version": "0.1.0",
  "description": "Autonomous Agent Migration Framework",
  "private": true,
  "type": "module",
  "bin": {
    "aamf": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "ci:prepush": "tsc --noEmit",
    "ci:local": "tsc --noEmit && vitest run --coverage",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@cadre-dev/framework": "^0.2.5",
    "@jafreck/lore": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "chalk": "^6",
    "commander": "^15",
    "date-fns": "^4",
    "fast-glob": "^3.3.3",
    "p-limit": "^7.3.2",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.5"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@vitest/coverage-v8": "^5.0.0",
    "tsx": "^4",
    "typescript": "^7.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
