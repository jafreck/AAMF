{
  "name": "aamf",
  "version": "0.1.0",
  "description": "Autonomous Agent Migration Framework",
  "private": true,
  "scripts": {
    "postinstall": "npm run install-runtime",
    "prebuild": "npm install --prefix runtime",
    "build": "npm run build --prefix runtime",
    "test": "npm test --prefix runtime",
    "install-runtime": "npm install --prefix runtime",
    "lint": "npm run lint --prefix runtime",
    "ci:prepush": "npm --prefix runtime run lint",
    "ci:local": "npm --prefix runtime run lint && npm --prefix runtime run test -- --coverage",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18"
  }
}
