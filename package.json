{
  "name": "aamf",
  "version": "0.1.0",
  "description": "Autonomous Agent Migration Framework",
  "private": true,
  "type": "module",
  "bin": {
    "aamf": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "ci:prepush": "tsc --noEmit",
    "ci:local": "tsc --noEmit && vitest run --coverage",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@cadre-dev/framework": "^0.2.5",
    "@jafreck/lore": "^0.3.9",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.6.2",
    "chalk": "^5",
    "commander": "^14",
    "date-fns": "^4",
    "fast-glob": "^3.3.3",
    "p-limit": "^7.3.0",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.3"
  },
  "devDependencies": {
    "@types/node": "^25",
    "@vitest/coverage-v8": "^4.1.2",
    "tsx": "^4",
    "typescript": "^6.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
