{
  "projectName": "zstd-to-rust",
  "source": {
    "path": "./zstd-src/zstd-1.5.7",
    "language": "c",
    "entryPoints": [
      "lib/compress/zstd_compress.c",
      "programs/zstdcli.c"
    ],
    "excludePatterns": [
      ".git",
      "*.o",
      "*.lo",
      "*.la",
      "*.pc",
      "Makefile*",
      "*.md",
      "legacy"
    ]
  },
  "target": {
    "language": "rust",
    "framework": "stable",
    "outputPath": "./tmp/zstd-rust-output",
    "testFramework": "cargo-test",
    "buildCommand": "cargo build",
    "testCommand": "cargo test"
  },
  "options": {
    "maxParallelAgents": 3,
    "maxRetriesPerTask": 2,
    "largeFileThreshold": 500,
    "maxLinesPerTask": 500,
    "tokenBudget": 10000000,
    "dryRun": false,
    "resume": true
  },
  "copilot": {
    "cliCommand": "copilot",
    "model": "claude-sonnet-4.6",
    "agentDir": "../../../../.github/agents",
    "timeout": 3600000
  }
}
