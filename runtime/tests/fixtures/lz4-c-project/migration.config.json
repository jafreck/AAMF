{
  "projectName": "lz4-to-rust",
  "source": {
    "path": "./lz4-src/lz4-1.10.0",
    "language": "c",
    "entryPoints": [
      "lib/lz4.c",
      "programs/lz4cli.c"
    ],
    "excludePatterns": [
      ".git",
      ".github",
      ".circleci",
      "*.o",
      "*.lo",
      "*.la",
      "*.pc",
      "*.rc.in",
      "Makefile*",
      "*.md",
      "*.1",
      "*.yml",
      "build/**",
      "contrib/**",
      "doc/**",
      "ossfuzz/**",
      "tests/**",
      "examples/**",
      "dll/**",
      "CODING_STYLE",
      "INSTALL",
      "SECURITY.md",
      "NEWS",
      "LICENSE",
      "COPYING",
      ".clang-format",
      ".gitignore",
      ".gitattributes"
    ]
  },
  "target": {
    "language": "rust",
    "framework": "stable",
    "outputPath": "./tmp/lz4-rust-output",
    "testFramework": "cargo-test",
    "buildCommand": "cargo build",
    "testCommand": "cargo test"
  },
  "options": {
    "qualityPolicy": "strict",
    "maxParallelAgents": 5,
    "maxRetriesPerTask": 2,
    "maxLinesPerTask": 500,
    "tokenBudget": 1000000,
    "dryRun": false,
    "resume": true,
    "kbIndex": {
      "enabled": true,
      "embeddings": {
        "enabled": true
      }
    }
  },
  "copilot": {
    "cliCommand": "copilot",
    "model": "claude-sonnet-4.6",
    "agentDir": "../../../../.github/agents",
    "timeout": 1800000
  }
}
