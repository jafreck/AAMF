{
  "projectName": "jq-to-csharp-net9",
  "source": {
    "path": "./jq-src/jq-1.8.1",
    "language": "c",
    "entryPoints": ["src/main.c"],
    "excludePatterns": [".git", "*.o", "*.lo", "*.la", "*.pc", "*.m4", "Makefile*", "config.*", "configure*", "libtool", "stamp-*", "aclocal*", "autom4te*", "compile", "depcomp", "install-sh", "missing", "ltmain.sh", "test-driver", "docs/**", "tests/**", "m4/**"]
  },
  "target": {
    "language": "csharp",
    "framework": "net9.0",
    "outputPath": "./tmp/jq-csharp-output",
    "testFramework": "xunit",
    "buildCommand": "dotnet build",
    "testCommand": "dotnet test"
  },
  "options": {
    "qualityPolicy": "strict",
    "maxParallelAgents": 3,
    "maxRetriesPerTask": 2,
    "maxLinesPerTask": 500,
    "tokenBudget": 500000,
    "dryRun": false,
    "resume": false,
    "kbIndex": {
      "enabled": true,
      "embeddings": {
        "enabled": true
      }
    }
  },
  "copilot": {
    "cliCommand": "copilot",
    "model": "claude-sonnet-4.6",
    "agentDir": "../../../../.github/agents",
    "timeout": 300000
  }
}
