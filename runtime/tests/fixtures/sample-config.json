{
  "projectName": "test-migration",
  "source": {
    "path": "./fixtures/source",
    "language": "python",
    "entryPoints": ["main.py"],
    "excludePatterns": ["__pycache__", ".git"]
  },
  "target": {
    "language": "typescript",
    "framework": "express",
    "outputPath": "./fixtures/output",
    "testFramework": "vitest",
    "buildCommand": "npm run build",
    "testCommand": "npm test"
  },
  "options": {
    "maxParallelAgents": 2,
    "maxRetriesPerTask": 2,
    "largeFileThreshold": 300,
    "maxLinesPerTask": 400,
    "dryRun": false,
    "resume": false
  },
  "copilot": {
    "cliCommand": "copilot",
    "model": "gpt-4o",
    "agentDir": ".github/agents",
    "timeout": 60000
  }
}
