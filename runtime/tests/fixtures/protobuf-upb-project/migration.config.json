{
  "projectName": "protobuf-upb-to-rust",
  "source": {
    "path": "./protobuf-src/protobuf-33.5/upb/upb",
    "language": "c",
    "entryPoints": [
      "decode.c",
      "encode.c"
    ],
    "excludePatterns": [
      ".git",
      "*.o",
      "*.lo",
      "*.la",
      "*.pc",
      "Makefile*",
      "*.md",
      "*_test.c",
      "fuzz"
    ]
  },
  "target": {
    "language": "rust",
    "framework": "stable",
    "outputPath": "./tmp/protobuf-upb-rust-output",
    "buildCommand": "cargo build",
    "testCommand": "cargo test"
  },
  "options": {
    "qualityPolicy": "strict",
    "maxParallelAgents": 3,
    "maxRetriesPerTask": 2,
    "maxLinesPerTask": 500,
    "tokenBudget": 3000000,
    "dryRun": false,
    "resume": true,
    "kbIndex": {
      "enabled": true,
      "embeddings": {
        "enabled": true
      }
    }
  },
  "agentBackend": {
    "runtime": "copilot",
    "cliCommand": "copilot",
    "model": "claude-sonnet-4.6",
    "agentDir": "../../../../.github/agents",
    "timeout": 1800000
  }
}
