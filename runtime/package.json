{
  "name": "aamf-runtime",
  "version": "0.1.0",
  "description": "Agent Architecture for Migration Framework — TypeScript Runtime Layer",
  "type": "module",
  "bin": {
    "aamf": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "postinstall": "rm -rf node_modules/@aamf/lore/node_modules/tree-sitter node_modules/@aamf/lore/node_modules/tree-sitter-c 2>/dev/null || true"
  },
  "dependencies": {
    "@aamf/lore": "npm:@jafreck/lore@^0.3.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.6.2",
    "chalk": "^5",
    "commander": "^14",
    "date-fns": "^4",
    "fast-glob": "^3.3.3",
    "p-limit": "^7.3.0",
    "sqlite-vec": "^0.1.6",
    "tree-sitter": "0.21.1",
    "tree-sitter-c": "0.23.1",
    "tree-sitter-c-sharp": "0.23.1",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-go": "0.23.4",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-python": "0.23.4",
    "tree-sitter-rust": "0.23.0",
    "tree-sitter-typescript": "0.23.2",
    "zod": "^4.3"
  },
  "devDependencies": {
    "@types/node": "^25",
    "@vitest/coverage-v8": "^4.0.18",
    "tsx": "^4",
    "typescript": "^5.9",
    "vitest": "^4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "tree-sitter": "0.21.1",
    "tree-sitter-c": "0.23.1"
  }
}
