{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskDecomposerOutputFile",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "sourceFiles",
      "targetFiles",
      "knowledgeBaseRef",
      "dependencies",
      "complexity",
      "description",
      "acceptanceCriteria",
      "parityChecks",
      "lineRange"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^task-[0-9]+$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "sourceFiles": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1
      },
      "targetFiles": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1
      },
      "knowledgeBaseRef": {
        "type": "string",
        "minLength": 1
      },
      "dependencies": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^task-[0-9]+$"
        }
      },
      "complexity": {
        "type": "string",
        "enum": ["simple", "moderate", "complex"]
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "acceptanceCriteria": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1
      },
      "parityChecks": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1
      },
      "lineRange": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end"],
        "properties": {
          "start": { "type": "integer", "minimum": 1 },
          "end": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}